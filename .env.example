# App OAuth do GHL Marketplace (distribuição "Agency" ou "Agency & Sub-Account").
# É o MESMO app pra todas as agências que forem conectar — cada instalação gera
# um tenant isolado automaticamente, identificado pelo companyId.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# URL pública final deste serviço (sem barra no final), ex: https://ghl-mcp.suaempresa.com
# Precisa bater com o redirect_uri cadastrado no app GHL: <PUBLIC_URL>/oauth/ghl/callback
PUBLIC_URL=

# Porta em que o processo escuta. Muitas plataformas de hosting sobrescrevem isso automaticamente.
PORT=8080

# Connection string de um Postgres (Supabase, Neon, RDS, Render Postgres, etc.)
DATABASE_URL=

# 32 bytes em base64, usados pra criptografar (AES-256-GCM) os refresh tokens da GHL em repouso.
# Gerar com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
